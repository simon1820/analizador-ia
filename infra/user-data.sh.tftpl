#!/bin/bash
set -euxo pipefail

# Cambiar app_version obliga a Terraform a crear una versión nueva del
# launch template y el ASG reemplaza las instancias (instance refresh).
# app_version: ${app_version}

REPO_URL="${repo_url}"
GIT_REF="${git_ref}"
APP_DIR="/opt/analizador-ia"

dnf install -y git
curl -fsSL https://rpm.nodesource.com/setup_22.x | bash -
dnf install -y nodejs

corepack enable
corepack prepare pnpm@11.9.0 --activate

id -u app &>/dev/null || useradd --system --create-home --shell /sbin/nologin app

git clone "$REPO_URL" "$APP_DIR"
cd "$APP_DIR"
git checkout "$GIT_REF"
pnpm install --frozen-lockfile
pnpm run build
chown -R app:app "$APP_DIR"

cat > /etc/systemd/system/analizador.service <<'UNIT'
[Unit]
Description=Analizador de resenas
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=app
WorkingDirectory=/opt/analizador-ia
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=AWS_REGION=${aws_region}
Environment=IA_PROVEEDOR=${ia_proveedor}
%{ if ia_modelo != "" ~}
Environment=IA_MODELO=${ia_modelo}
%{ endif ~}
Environment=ANTHROPIC_API_KEY_PARAM=${api_key_param}
%{ if workspace_id != "" ~}
Environment=ANTHROPIC_WORKSPACE_ID=${workspace_id}
%{ endif ~}
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now analizador.service
